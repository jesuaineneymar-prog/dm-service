generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:local.db"
}

model Prospect {
  id           String   @id @default(cuid())
  platform     String
  username     String
  displayName  String?
  followers    Int      @default(0)
  following    Int      @default(0)
  bio          String?
  profileUrl   String?
  avatarUrl    String?
  score        Float    @default(0)
  category    String?  @default("prospect")
  status       String   @default("new")
  notes        String?
  externalId   String?
  lastContactedAt DateTime?
  lastRepliedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     Message[]
  followUps    FollowUp[]
}

model Message {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  direction    String
  content      String
  platform     String?
  sentAt       DateTime  @default(now())
  isRead       Boolean   @default(false)
}

model FollowUp {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  status       String    @default("pending")
  message      String?
  sentAt       DateTime?
  result       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  platform     String
  eventType    String
  metricValue  Float    @default(0)
  metadata     String?
  recordedAt   DateTime @default(now())
}

model ContentPost {
  id           String   @id @default(cuid())
  platform     String?
  caption      String
  hashtags     String?
  mediaUrl     String?
  mediaType    String?
  status       String   @default("draft")
  scheduledAt  DateTime?
  publishedAt  DateTime?
  engagementData String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scheduledPosts ScheduledPost[]
}

model ScheduledPost {
  id           String   @id @default(cuid())
  contentPostId String
  contentPost   ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  platforms    String
  scheduledFor DateTime
  status       String   @default("pending")
  uploadPostId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  type          String
  title         String
  message       String
  platform      String?
  sourceId      String?
  isRead        Boolean  @default(false)
  metadata      String?
  createdAt     DateTime @default(now())
}

model AutomationLog {
  id            String   @id @default(cuid())
  type          String
  action        String
  platform      String?
  targetId      String?
  targetName    String?
  status        String   @default("pending")
  result        String?
  triggeredAt   DateTime @default(now())
  completedAt   DateTime?
}

model ABTest {
  id             String   @id @default(cuid())
  name           String
  platform       String
  variantA       String   // caption variante A
  variantB       String   // caption variante B
  hashtagsA      String?
  hashtagsB      String?
  status         String   @default("draft") // draft, running, completed, cancelled
  impressionsA   Int      @default(0)
  impressionsB   Int      @default(0)
  likesA         Int      @default(0)
  likesB         Int      @default(0)
  commentsA      Int      @default(0)
  commentsB      Int      @default(0)
  winner         String?  // "A", "B", or "tie"
  contentPostId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClientReport {
  id             String   @id @default(cuid())
  clientName     String
  periodStart    DateTime
  periodEnd      DateTime
  platform       String?
  followersStart Int      @default(0)
  followersEnd   Int      @default(0)
  postsPublished Int      @default(0)
  totalLikes     Int      @default(0)
  totalComments  Int      @default(0)
  totalDMs       Int      @default(0)
  newProspects   Int      @default(0)
  conversions    Int      @default(0)
  summary        String?
  generatedAt    DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
